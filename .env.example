# Copier ce fichier en .env (local) et renseigner les memes cles dans
# Vercel > Project Settings > Environment Variables pour la prod/preview.

# Endpoint Appwrite : https://cloud.appwrite.io/v1 (Cloud) ou http://localhost/v1 (self-hosted Docker)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=67ea7b5100381c86e477

# Base de donnees principale
VITE_APPWRITE_DATABASE_ID=67eaac4d00270f35f322

# Collections existantes
VITE_APPWRITE_JOBS_COLLECTION_ID=67eaacc50033130662c4
VITE_APPWRITE_EVENTS_COLLECTION_ID=67eaac61000fd1e98d80

# Nouvelles collections (contenu pilotable depuis le backoffice)
# A creer dans la console Appwrite - voir APPWRITE_SCHEMA.md
VITE_APPWRITE_BLOG_COLLECTION_ID=blog_posts
VITE_APPWRITE_TEAM_COLLECTION_ID=team_members
VITE_APPWRITE_TESTIMONIALS_COLLECTION_ID=testimonials
VITE_APPWRITE_SERVICES_COLLECTION_ID=services
VITE_APPWRITE_PROJECTS_COLLECTION_ID=projects
VITE_APPWRITE_PAGE_CONTENT_COLLECTION_ID=page_content
VITE_APPWRITE_CONTACT_MESSAGES_COLLECTION_ID=contact_messages
VITE_APPWRITE_APPLICATIONS_COLLECTION_ID=job_applications
VITE_APPWRITE_SETTINGS_COLLECTION_ID=site_settings

# Stockage fichiers (images blog, logos, CV candidatures...)
VITE_APPWRITE_MEDIA_BUCKET_ID=media

# --- SEO / Analytics -----------------------------------------------------

# URL de production du site (sans slash final) - utilisee pour les balises
# canonical, Open Graph et le sitemap.xml
VITE_SITE_URL=https://www.opentek.com

# Google Analytics 4 (laisser vide tant que le compte n'est pas cree)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager (si utilise, prioritaire sur VITE_GA_MEASUREMENT_ID)
VITE_GTM_ID=

# Code de verification Google Search Console (Parametres > Verification de propriete > balise HTML)
VITE_GOOGLE_SITE_VERIFICATION=

# --- Cloudinary (stockage des images uniquement) --------------------------
# Les CV de candidature restent sur Appwrite Storage - seules les images
# (blog, portfolio, services, temoignages, equipe) passent par Cloudinary.
# Cloud name : visible en haut du dashboard Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=

# Preset d'upload "unsigned" a creer dans Cloudinary :
# Settings > Upload > Upload presets > Add upload preset > Signing Mode: Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET=
